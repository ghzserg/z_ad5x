#!/bin/sh
# (C) 2026 ghzserg https://github.com/ghzserg/zmod
#
# Starts orca_ff service
#

PID_FILE=/run/orca_ff.pid

start() {
    start-stop-daemon -S -b -m -p $PID_FILE --exec /usr/data/zmod/zmod/.shell/root/orca_ff.py
}

stop() {
    start-stop-daemon -K -p $PID_FILE
}
restart() {
    stop
    sleep 1
    start
}

if grep -q "orca_ff = 1" /opt/config/mod_data/variables.cfg && grep -q "display_off = 1" /opt/config/mod_data/variables.cfg; then
case "$1" in
  start)
        start
        ;;
  stop)
        stop
        ;;
  restart|reload)
        restart
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
fi

exit $?
